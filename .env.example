# GEMINI_API_KEY: Required for Gemini Vision AI inference calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
CORS_ORIGIN="*"

# Persistent Storage Configuration
# STORAGE_BACKEND: "local" (persistent disk directory) or "s3" (S3-compatible object storage)
STORAGE_BACKEND="local"
STORAGE_ROOT="./data/storage"
DB_PATH="./data/construction_vision.db"

# Optional External S3 / Object Storage (used when STORAGE_BACKEND="s3")
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional External Python FastAPI + YOLO Inference Server URL (e.g. http://localhost:8000)
# Leave empty to use built-in Gemini Vision AI inference directly.
PYTHON_BACKEND_URL=""
